</div>
<script>
$(document).ready(function () {
    $('#cssmenu').on('click touchend', 'li:not(.current) a', function () {
        $('.current').not($(this).closest('li').addClass('current')).removeClass('active');
    	$(this).closest('li').addClass('current').addClass('active');
		//$(this).addClass('active');
		$('.current').not($(this).closest('li').addClass('current')).removeClass('current');
        // fade out all open subcontents
        $('.mainContent:visible').hide(0);
        // fade in new selected subcontent
        $('.mainContent[id=' + $(this).attr('data-id') + ']').show(0);
    }).find('a:first').click();
});
</script>
</body>
</html>
