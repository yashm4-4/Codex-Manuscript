            <li style="list-style-type:none"><br>
            <li style="margin: 0px 0px 0px 22.5px"><i class="fa-li fa fa-file"></i><a href='finemap_v1.3.1_MacOSX.tgz' target="_blank">finemap_v1.3.1_MacOSX.tgz (Mac OS X)</a></li>
			<li style="margin: 0px 0px 0px 22.5px"><i class="fa-li fa fa-file"></i><a href='finemap_v1.3.1_x86_64.tgz' target="_blank">finemap_v1.3.1_x86_64.tgz (Unix)</a></li>
            <li style="margin: 0px 0px 0px 22.5px"><i class="fa-li fa fa-book"></i><a href='index_v1.3.html' target="_blank">Documentation</a></li>
            <li style="list-style-type:none"><br>
            <li style="margin: 0px 0px 0px 22.5px"><i class="fa-li fa fa-file"></i><a href='finemap_v1.3_MacOSX.tgz' target="_blank">finemap_v1.3_MacOSX.tgz (Mac OS X)</a></li>
			<li style="margin: 0px 0px 0px 22.5px"><i class="fa-li fa fa-file"></i><a href='finemap_v1.3_x86_64.tgz' target="_blank">finemap_v1.3_x86_64.tgz (Unix)</a></li>
            <li style="margin: 0px 0px 0px 22.5px"><i class="fa-li fa fa-book"></i><a href='index_v1.3.html' target="_blank">Documentation</a></li>
