,\"$L72\",[\"$\",\"$3\",\"3df84d5fccd0418c89897b07a7a55e78\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":\") and SuSiE (\"}]]}],\"$L73\",[\"$\",\"$3\",\"353f75ce68c34cdc8c01e23625fb03f0\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":\") to fine-map genome-wide significant loci in FinnGen endpoints.\"}]]}]]}],[\"$\",\"p\",\"d0a732db6cb347bfaf65226ab7175d1e\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$3\",\"cd07098f9c434436ade57f2810837340\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":\"Briefly, there are three main steps:\"}]]}]]}],\"$L74\",[\"$\",\"p\",\"5a074dab67fe4bdfb964317320070822\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$3\",\"62bc7234cf084b4c98811ff5c3b19464\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":\"For each genome-wide significant locus (default configuration: P \u003c 5e-8), we define a fine-mapping region by taking a 3 Mb window around a lead variant (and merge regions if they overlap). If a merged window exceeds 10MB, we iteratively shrink the window by 10%, until the merged window fits into 10MB or is split into merged windows that each fit into 10MB. We preprocess an input GWAS summary statistics into separate files per region for the following steps.\"}]]}]]}],[\"$\",\"p\",\"J7B8CFDcoNGc\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$3\",\"za2IjxWN9xf8\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":[\"$\",\"strong\",\"mark\",{\"className\":\"font-bold\",\"children\":\"Note\"}]}],[\"$\",\"$3\",\"1\",{\"children\":\": Due to the complexity of the HLA region and the difficulty in finemapping this region, by default we exclude the region 25Mb to 34Mb (hg38; inclusive) of chromosome 6 during the preprocessing step. Therefore, the HLA region is not finemapped as part of the standard FinnGen finemapping pipelines.\"}]]}]]}],\"$L75\",[\"$\",\"p\",\"67f87986baae4115ac64f78c67671828\",{\"data-cover-aware-text\":\"\",\"className\":\"paragraph decoration-primary/6 max-w-3xl w-full print:break-inside-avoid text-start self-start justify-start\",\"children\":[[\"$\",\"$3\",\"3c5147584bdd437b8cb139389d0980e4\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":\"We compute in-sample dosage LD using \"}]]}],\"$L76\",[\"$\",\"$3\",\"c3d16e1294354be78983c0af3c8d2c92\",{\"children\":[[\"$\",\"$3\",\"0\",{\"children\":\" for each fine-mapping region.\"}]]}]]}],\"$L77\",\"$L78\",\"$L79\",\"$L7a\",\"$L7b\",\"$L7c\"]}]}]]]}],\"$L7d\",\"$L7e\"]}],\"$L7f\"]}]\n"])</script><script>self.__next_f.push([1,"83:I[80454,[\"6268\",\"static/chunks/f5718501-ee9a6dc237bd8306.js\",\"2122\",\"static/chunks/9071f66d-65831af376c95d36.js\",\"9246\",\"static/chunks/9246-30e02f67a3865098.js\",\"6213\",\"static/chunks/6213-fcd8f601a9fdf399.js\",\"6811\",\"static/chunks/6811-b5a1327b6b81e44f.js\",\"8925\",\"static/chunks/8925-fc82b5bf6a6d3c99.js\",\"9935\",\"static/chunks/9935-f2b9e3273b061468.js\",\"2335\",\"static/chunks/2335-edb8063abde615e1.js\",\"277\",\"static/chunks/277-ffb51a8042c5883f.js\",\"766\",\"static/chunks/766-ad737af1edc9a181.js\",\"26\",\"static/chunks/26-aed9198e9a1dec34.js\",\"8617\",\"static/chunks/app/sites/static/%5Bmode%5D/%5BsiteURL%5D/%5BsiteData%5D/(content)/%5BpagePath%5D/page-e7dd36736b11528b.js\"],\"TableSearchProvider\"]\n85:I[29183,[\"6268\",\"static/chunks/f5718501-ee9a6dc237bd8306.js\",\"2122\",\"static/chunks/9071f66d-65831af376c95d36.js\",\"9246\",\"static/chunks/9246-30e02f67a3865098.js\",\"6213\",\"static/chunks/6213-fcd8f601a9fdf399.js\",\"6811\",\"static/chunks/6811-b5a1327b6b81e44f.js\",\"8925\",\"static/chunks/8925-fc82b5bf6a6d3c99.js\",\"9935\",\"static/chunks/9935-f2b9e3273b