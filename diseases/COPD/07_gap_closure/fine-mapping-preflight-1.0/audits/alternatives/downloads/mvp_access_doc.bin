                                        .page-joinmvp .section2blueinner .set2Content2 h2 {
                                            margin: 0em 0em 0em 1em !important;
                                        }
                                        .page-joinmvp .content .style1Wrapper .veteran-banner-text .bannerTextWrapper h1 {
                                            padding-top: 1em;
                                            margin: 0;
                                            padding-bottom: 1em;
                                            font-weight: 900;
                                        }
                                        .page-joinmvp .content .style1Wrapper .veteran-banner-text h2.pwa-tagline {
                                        display: none !important;
                                        }
                                        .page-joinmvp .container .hub-rowwrapper .bannerTextButton {
                                        text-align: left !important;
                                        }
                                        .page-joinmvp.contentWrapperva .pwa-list ol li {
                                            border-bottom: none;
                                        }
                                        .va-h-ruled--stars {
                                            display: flex;
                                            justify-content: center;
                                            align-items: center;
                                            background: url(https://design.va.gov/storybook/static/media/stars.954f834f.7f751b3b.png) no-repeat 50%;
                                            background-size: 11rem auto;
                                            margin: 1.6rem auto auto;
                                            padding: 2rem 0 0;
                                            text-align: center;
                                            height:1em;
                                        }
                                        .va-h-ruled--stars:after, .va-h-ruled--stars:before {
                                            border-top: 1px solid #aeb0b5;
                                            content: " ";
                                            flex: 1 1 50%;
                                            padding: 1rem 0;
                                        }
                                        .va-h-ruled--stars:before {
                                            margin-right: 12rem;
                                        }
                                        *, :after, :before {
                                            box-sizing: inherit;
                                        }
                                        .page-joinmvp .container .block_4_col_cta.variation- .multiColWrapper .cardTextDiv img {
                                            width: auto !important;
                                            max-width: 235px !important;
                                            height: 100px !important;
                                        }
                                        .page-joinmvp .container .section1b {
                                            padding: 1em;
                                        	margin-top: 1em !important;
                                        }
                                        ------------Unsubscribe page---------------------
                                        .page-unsubscribe div #block-pagetitle {display:none;}
                                        .page-unsubscribe #block-pagetitle h1{display:none;}
                                            /*----Spread the word-----*/
                                            .page-spreadtheword .content .App div.react-search-field.search-field {
                                                display: none !important;}
                                            /*----Researcher FAQs-----*/
                                            .page-researcher-FAQ .container .hub-rowwrapper div.style3Wrapper div.veteran-banner-text .bannerTextWrapper {
                                                 margin: 1em 0em !important;}
                                            .page-researcher-FAQ .content .style3Wrapper .veteran-banner-text h2.pwa-tagline {display: none !important;}
                                            .description-faq {display: none !important;}
                /*----------Hide Login Button ------*/
                    /*   #login-pwa {visibility: hidden;}  	*/
                                        </style></p>
</div>
