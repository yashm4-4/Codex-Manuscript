# Shared read-only assets (127 GB / 2.3 TB). Never committed.
# In a clone these are symlinks created by setup.sh; do not add them to git.
/data
/models
/reference_papers

# Per-section working content: only scripts and READMEs are tracked.
# Each user regenerates these in their own clone (setup.sh creates the dirs).
diseases/*/*/data/
diseases/*/*/results/
diseases/*/*/logs/
diseases/*/*/tmp/

# Large model-training and interpretation intermediates. The compact,
# checksummed scientific summaries used by the manuscript live in each
# section's results directory and may be force-added for a release.
diseases/*/04_modeling/trednet/input_training_data/
diseases/*/04_modeling/trednet/logs/
diseases/*/04_modeling/trednet/models_output/
diseases/*/04_modeling/deepexplainer/output/

# Machine-local links into shared model/reference workspaces.
diseases/*/04_modeling/trednet/fasta
diseases/*/04_modeling/trednet/model_phase_I
diseases/*/04_modeling/deepexplainer/backup

# Local editor/agent state
/.claude/

# Stray local files at repo root
/*.tbi
/*.gz

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
